base uppercase Z z
base uppercase Ç ç
base uppercase Ğ ğ
base uppercase I ı
base uppercase Ö ö
base uppercase Ş ş
base uppercase Ü ü

# Genel Semboller
# ¦ (kesik çubuk) kaldırıldı — tek hücre 123456 zaten "always la" kısaltması
# tarafından gölgeleniyordu (Madde 80, cihazda kanıtlandı: dots=123456 -> "la").
# ¤ (para birimi) kaldırıldı — tek hücre 345 zaten "always se" kısaltması
# tarafından gölgeleniyordu (Madde 80, cihazda kanıtlandı: dots=345 -> "se").
sign ¿ 1346
sign ¨ 2456
sign ° 12345
sign · 156
sign ~ 45
sign # 3456-6
sign \\ 456-16                    # Madde 80: backslash tek sahip, tek hücre 4 ile çakışmıyor
sign | 6
sign + 56-26
# sign % 13456    ← KALDIRILDI: 13456 = `lowercase y` (Türkçe "y" harfi) ile
                  # çakışıyordu. % sözleşmesi artık çoklu hücre 456-1456.
sign % 456-1456
sign = 56-2356
sign ^ 5
sign @ 4                          # Madde 80: tek hücre 4'ün tek sahibi @
sign & 12346
# £ (sterlin) kaldırıldı — tek hücre 4 artık yalnız @ üretiyor (Madde 80).
sign $ 2346
# ¢ (sent) tek hücre kaldırıldı — dots=345 zaten "always se" kısaltması
# tarafından gölgeleniyordu (Madde 80, cihazda kanıtlandı). İki hücreli
# 456-345 eşlemesi (aşağıda) korunuyor, ¢ o yoldan hâlâ erişilebilir.
sign * 56-35
sign _ 456
sign \x2022 3 • Bullet sign
sign \x00B7 3 · Interpunct
sign - 36 Hyphen, not a dash. Hyphens are spaced as in print text.
sign \x2013 36 – En-dash, not a hyphen.
sign \x2014 36 – Em-dash, not a hyphen.
sign \x2022 56-3
sign \x00B1 56-26-36
sign & 456-12346
sign / 456-34
sign $ 456-2346
sign ^ 456-5
sign ~ 456-45
sign \x00A2 456-345
sign \x221E 456-123456

# Matematik Sembolleri
sign \x2212 56-36 − Minus sign, not a hyphen
math \x2030 25-1456 ‰ Per mille sign
# ∞ (math) tek hücre kaldırıldı — dots=123456 zaten "always la" kısaltması
# tarafından gölgeleniyordu (Madde 80, cihazda kanıtlandı). İki hücreli
# sign 456-123456 eşlemesi (yukarıda) korunuyor, ∞ o yoldan hâlâ erişilebilir.
math \x00B0 3-14 ° Degree symbol
math \x2219 3 ∙ Bullet operator
math \x22C5 2 ⋅ Dot operator
sign \x00D7 56-236 × Multiplication sign
sign \x00F7 56-25 ÷ Division sign; Obelus
decpoint , 2 Decimal comma
decpoint . 256
decpoint : 25

# Karakter Belirteçleri
numsign 3456
# Sayı modu Hedef 5: kelime içi 56 (letsign) + 3456 (numsign) ikilisi, iki
# hücreli hash aramasında (back_selectRule tryThis=0) tek hücreli "midword ki
# 3456" kuralından ÖNCE bulunur — bu yüzden mid-word'de doğrudan sayı dizisini
# başlatır, 56 önekiyse ki yorumunu geçersiz kılar.
numsign 56-3456
letsign 56
#noletsignafter .
#noletsignafter '
capsletter 6
begcapsword 6-6
endcapsword 6-3

emphclass italic
emphclass underline
emphclass bold

begemphphrase italic 46-46
endemphphrase italic before 46
lenemphphrase italic 4
begemphword italic 46-3
endemphword italic 46-36
emphletter italic 46-25

begemphphrase bold 456-456
#lastwordboldbefore 456
lenemphphrase bold 4
#begcomp 456-346
# endcomp 456-156

# Rakkamlar
digit 0 2457
digit 1 17
digit 2 127
digit 3 147
digit 4 1457
digit 5 157
digit 6 1247
digit 7 12457
digit 8 1257
digit 9 247

# multind 56-6 letsign capsign

# Accented Letters
# OPEN_WORK 359: 4. noktayla başlayan aksanlı harfler (â, é, ñ, ś ...) ve büyük hâlleri kaldırıldı;
# @ tek hücre 4 olduğu için @ ardından yazılan harfle birleşiyorlardı. Liste OPEN_WORK 360 simge panelinde.
noback lowercase   \x00E6      1-15          æ  &#230;   LATIN LETTER AE
noback lowercase   \x0153      135-15        œ  &#339;   LATIN LIGATURE OE

base uppercase        \x00C6 \x00E6      Ææ  &#198;&#230;   LATIN LETTER AE
base uppercase        \x0152 \x0153      Œœ  &#338;&#339;   LATIN LIGATURE OE

# Correct order of comma and numeric indicator
match %. , %# 2-3456
noback pass2 @3456-2-3456 @2-3456

# Correct order of dot and numeric indicator
match %. . %# 256-3456
noback pass2 @3456-256-3456 @256-3456

# Ki word part related exceptions
always kia 13-24-1
always kib 13-24-12
always kic 13-24-14
always kid 13-24-145
always kie 13-24-15
always kif 13-24-124
always kig 13-24-1245
always kih 13-24-125
always kii 13-24-24
always kij 13-24-245

# özel karakter düzeltmeleri
word o 135
word O 135
always ... 256-256-256
begnum $ 2346
midnum - 36
midnum , 2
midnum : 25
midnum ' 3
midendnumericmodechars .,:/-

# Madde 85: özel ad veya rakamdan sonra kesme ile başlayan tek harfli ekler,
# tek hücreli whole-word kısaltması olarak genişlememelidir. Bu altı ünlü Türkçe
# tek harfli eklerin gerçek varyantlarıdır. "after" kapısı, kelime/boşluk
# başındaki açılış tırnağında bağımsız word kurallarının normal kalmasını sağlar.
after letter after litdigit always 'a 3-1
after letter after litdigit always 'e 3-15
after letter after litdigit always 'ı 3-35
after letter after litdigit always 'i 3-24
after letter after litdigit always 'u 3-136
after letter after litdigit always 'ü 3-1256

# Apostrof, back-translation sırasında ayrı punctuation çıktısı ürettiği için
# aşağıdaki nın/nin/nun/nün hücreleri normal midendword kapısını kaybeder.
# Buffer-n alan genitif eki yalnız ünlüyle biten kökten sonra geçerlidir; dört
# dar karakter sınıfı apostrofu da içeren birleşik kuralı doğru vowel-harmony
# varyantıyla seçer. Böylece opening quote veya diğer midendword aileleri açılmaz.
attribute guvenBackUnroundedVowel aAıI
attribute guvenFrontUnroundedVowel eEiİ
attribute guvenBackRoundedVowel oOuU
attribute guvenFrontRoundedVowel öÖüÜ
after guvenBackUnroundedVowel always 'nın 3-56-1345
after guvenFrontUnroundedVowel always 'nin 3-56-1345
after guvenBackRoundedVowel always 'nun 3-45-1345
after guvenFrontRoundedVowel always 'nün 3-45-1345

endnum a 56-1
endnum b 56-12
endnum c 56-14
endnum d 56-145
endnum e 56-15
endnum f 56-124
endnum g 56-1245
endnum h 56-125
endnum i 56-24
endnum j 56-245
endnum A 6-1
endnum B 6-12
endnum C 6-14
endnum D 6-145
endnum E 6-15
endnum F 6-124
endnum G 6-1245
endnum H 6-125
endnum İ 6-24
endnum J 6-245

repeated .... 256-256-256
repeated ____ 456
repeated ---- 36

multind 56-6 letsign capsletter

